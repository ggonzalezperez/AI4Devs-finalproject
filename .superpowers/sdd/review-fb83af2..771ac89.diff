+def _child_token(db_session):
+    fam = Family(name="FamImg")
+    db_session.add(fam)
+    db_session.flush()
+    child = Child(family_id=fam.id, name="Leo", birthdate=date(2018, 1, 1), pin_hash="x")
+    db_session.add(child)
+    db_session.commit()
+    return create_token(subject=str(child.id), token_type="child")
