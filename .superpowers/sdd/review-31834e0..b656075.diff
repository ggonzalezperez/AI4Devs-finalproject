+
+def list_thread(db: Session, child_id: int, lesson_id: int) -> list[Lesson]:
+    anchor = get_for_child(db, child_id, lesson_id)
+    if anchor is None:
+        return []
+    root_id = anchor.root_id or anchor.id
+    rows = db.execute(
