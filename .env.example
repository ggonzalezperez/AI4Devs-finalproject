# Copia a .env y rellena. NO se commitea (.env está en .gitignore del backend; añade .env a .gitignore raíz si hace falta).
# Secreto JWT (mínimo 32 caracteres en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Clave maestra para cifrar las API keys de las familias (Fernet).
# Genera una con:
#   docker compose run --rm backend python -c "from app.services.crypto import generate_key; print(generate_key())"
AI_CONFIG_KEY=

# Base de datos (CÁMBIALAS en producción; no dejes la contraseña por defecto).
POSTGRES_USER=chispa
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=chispa

# --- Despliegue expuesto a internet ---
# Palabra secreta que exige el alta de familia. Sin definir, el registro queda
# abierto (lo normal en casa). Defínela si publicas la app fuera de tu red.
# INVITE_CODE=

# Cabecera de la que fiarse para conocer la IP real de quien llama, usada por el
# límite de intentos. Solo si hay un proxy de confianza delante: tras el túnel
# de Cloudflare es CF-Connecting-IP. Sin definir no se cree ninguna cabecera,
# porque con el backend accesible en la red local se falsifica en un segundo.
# CLIENT_IP_HEADER=CF-Connecting-IP

# --- Acceso desde la red de casa (móvil/tablet) ---
# No hace falta configurar nada: el frontend sirve la API bajo /api en su mismo
# origen, así que la app funciona igual por localhost, por la IP de tu PC o por
# un dominio, sin reconstruir.
#
# ⚠️ NO definas VITE_API_URL para esto. Esa variable hornea la dirección del
# backend dentro del bundle y ata la aplicación a una máquina concreta: deja de
# funcionar al abrirla desde otro dispositivo y el navegador bloquea las
# llamadas si sirves la app por https. Solo sirve para apuntar a un backend
# ajeno a propósito.
#
# CORS solo interviene si atacas el backend directo por el puerto 8000. Con el
# origen único el navegador ya no cruza orígenes.
# CORS_ORIGINS=http://localhost:5173

# Interruptor del límite de intentos de credenciales. Activo por defecto;
# ponerlo a false solo tiene sentido depurando.
# RATE_LIMIT_ENABLED=true
